{
  "manifest_version": 3,
  "name": "A Modo Mio - Assistente intelligente de Saipos",
  "version": "1.0",
  "description": "Saipos assistant.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://conta.saipos.com/*",
    "https://amodomio.com.br/*",
    "https://www.amodomio.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://conta.saipos.com/*"
      ],
      "js": [
        "main.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.js"
      ],
      "matches": [
        "https://conta.saipos.com/*"
      ]
    }
  ]
}
